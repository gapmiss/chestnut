<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>Chestnut</string>
	<key>CFBundleIdentifier</key>
	<string>dev.gapmiss.chestnut</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleName</key>
	<string>Chestnut</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Both are placeholders: `make bundle` stamps the real values from
	     Makefile:VERSION and the commit count, and `make release-check`
	     asserts the stamp. Kept in step with VERSION so the file can't be
	     misread as a source of truth, and `make check` asserts that too —
	     it drifted two releases before anything enforced it. Edit this
	     value by hand: `plutil -replace` rewrites the file and drops this
	     comment. -->
	<key>CFBundleShortVersionString</key>
	<string>0.8.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSDesktopFolderUsageDescription</key>
	<string>Chestnut watches your Obsidian vaults so it can react while you write, and moves notes between them when you drop one on it. Allow access to use a vault kept on your Desktop.</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>Chestnut watches your Obsidian vaults so it can react while you write, and moves notes between them when you drop one on it. Allow access to use a vault kept in your Documents folder.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>Chestnut watches your Obsidian vaults so it can react while you write, and moves notes between them when you drop one on it. Allow access to use a vault kept in your Downloads folder.</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
</dict>
</plist>
